# Managed by Chef. Do not edit by hand.
# Template: mongodb/templates/mongod.conf.erb

storage:
  dbPath: <%= node['mongodb']['data_dir'] %>
  wiredTiger:
    engineConfig:
      cacheSizeGB: 1

systemLog:
  destination: file
  path: /var/log/mongodb/mongod.log
  logAppend: true

net:
  port: <%= node['mongodb']['port'] %>
  bindIp: <%= node['mongodb']['bind_ip'] %>

security:
  authorization: enabled

replication:
  replSetName: <%= node['mongodb']['replset'] %>
